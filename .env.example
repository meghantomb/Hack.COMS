# Server
PORT=3001
# Optional locally. Leave unset/commented for in-memory mode (no Postgres needed).
# If set but unreachable, the server falls back to memory mode automatically.
# On Vercel, set DATABASE_URL in the project env — memory mode loses progress across cold starts.
# Tiger Cloud: keep sslmode=require (server adds uselibpqcompat for Node).
# DATABASE_URL=postgresql://postgres:password@localhost:5432/duck_dating

XAI_API_KEY=
XAI_API_BASE=https://api.x.ai/v1
XAI_MODEL=grok-2-latest

# Client (Vite) — only public API URL, never secrets.
# Local: leave unset to use the Vite /api proxy, or set http://localhost:3001.
# Vercel (same-origin): leave unset / empty so the browser calls /api on the same host.
# VITE_API_URL=http://localhost:3001
